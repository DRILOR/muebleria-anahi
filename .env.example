DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8001,http://localhost:8001

# Configuración de base de datos MySQL
DB_NAME=muebleria_anahi
DB_USER=anahi_app
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=muebleria_anahi_test

# Opciones de seguridad para producción (HTTPS)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_BEHIND_PROXY=False
DJANGO_LOG_LEVEL=INFO
