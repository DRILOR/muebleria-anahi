[Unit]
Description=Mueblería Anahí - Sistema Inteligente de Gestión de Inventario
After=network.target mysql.service

[Service]
Type=notify
User=helen
Group=helen
WorkingDirectory=/home/helen/Proyectos/muebleria-anahi
EnvironmentFile=/home/helen/Proyectos/muebleria-anahi/.env
ExecStart=/home/helen/Proyectos/muebleria-anahi/.venv/bin/gunicorn config.wsgi:application --config deploy/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=30
PrivateTmp=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

